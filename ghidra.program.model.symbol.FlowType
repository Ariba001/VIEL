%!PS-Adobe-3.0
%%Creator: (ImageMagick)
%%Title: (ghidra.program.model.symbol.FlowType)
%%CreationDate: (2026-02-27T06:25:08+00:00)
%%BoundingBox: -0 -0 1920 1045
%%HiResBoundingBox: 0 0 1920 1045
%%DocumentData: Clean7Bit
%%LanguageLevel: 1
%%Orientation: Portrait
