# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.

# Path to the Ghidra headless analyzer binary.
# Linux / macOS : /path/to/ghidra_XX.X_PUBLIC/support/analyzeHeadless
# Windows       : C:\path\to\ghidra_XX.X_PUBLIC\support\analyzeHeadless.bat
GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
